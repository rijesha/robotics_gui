package rtk;
option pkgid = 7;

enum BaseMode { BASE_IDLE = 0; BASE_SURVEY_IN = 1; BASE_FIXED = 2; }

message BaseStatus {
  option msgid = 1;
  BaseMode mode = 1;
  float survey_progress = 2;
  uint32 survey_elapsed_s = 3;
  float accuracy_m = 4;
  double lat = 5;
  double lon = 6;
  float alt_m = 7;
  uint8 sats = 8;
  float rtcm_rate_hz = 9;
  uint32 rtcm_bytes = 10;
}

message BaseConfig {
  option msgid = 2;
  uint16 seq = 1;
  bool use_fixed = 2;
  uint32 min_duration_s = 3;
  float accuracy_limit_m = 4;
  double lat = 5;
  double lon = 6;
  float alt_m = 7;
}

message RtcmData {
  option msgid = 3;
  option variable = true;
  repeated uint8 data = 1 [max_size=200];
}
